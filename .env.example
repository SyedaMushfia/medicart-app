# Supabase project URL and server-only secret key.
# Never prefix the secret key with VITE_ or expose it to the frontend.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# Optional URL for a separately deployed backend.
# Locally, leave unset to use the Vite /api proxy.
# VITE_API_URL="https://your-api.example.com/api"
